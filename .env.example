# Copier en .env avant le premier `docker compose up` :
#   cp .env.example .env
#
# Ces valeurs conviennent a une demonstration locale. Le fichier .env lui-meme
# n'est jamais versionne : il figure dans .gitignore.

POSTGRES_DB=presences
POSTGRES_USER=presences
POSTGRES_PASSWORD=changez-moi-en-local

# Ports exposes sur la machine hote.
BACKEND_PORT=8080
FRONTEND_PORT=8081
